# --- PlatformIO / ESP-IDF ---
# Скачанные фреймворки, toolchain, объектные файлы и сгенерированный
# sdkconfig. Восстанавливаются автоматически при сборке.
.pio/
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock

# --- Собранные прошивки ---
out/
dist/
*.bin
*.elf
*.map

# --- Дампы флеша ---
# Снятые с плат образы чужих прошивок — не наше и не для публикации.
*-original.bin
*_dump.bin

# --- Архивы для передачи ---
*.rar
*.zip
*.7z

# --- Редакторы и IDE ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~

# --- ОС ---
Thumbs.db
desktop.ini
.DS_Store
