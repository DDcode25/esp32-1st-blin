# ESPBridge — настройки ESP-IDF

# Тик планировщика 1 мс вместо 10 мс по умолчанию. Влияет на разрешение
# таймаутов в задачах приёма: при 100 Гц минимальная задержка 10 мс, что
# сравнимо с периодом выдачи CRSF и делает тайминги грубыми.
CONFIG_FREERTOS_HZ=1000

# Ethernet: используется generic-драйвер PHY по IEEE 802.3. Драйверы
# конкретных микросхем в IDF 6 вынесены в отдельные компоненты, но LAN8720A
# соответствует стандарту и работает через стандартные регистры.
CONFIG_ETH_USE_ESP32_EMAC=y
# Пины RMII и режим тактирования задаются в коде (net_eth.c), а не здесь:
# в IDF 6 они входят в структуру eth_esp32_emac_config_t.

# Размер буферов драйвера Ethernet. Значения по умолчанию рассчитаны на
# редкий крупный трафик, у нас — частый мелкий.
CONFIG_ETH_DMA_BUFFER_SIZE=512
CONFIG_ETH_DMA_RX_BUFFER_NUM=10
CONFIG_ETH_DMA_TX_BUFFER_NUM=10

# Лог по умолчанию — информационный. Отладочный слишком многословен и сам
# по себе влияет на тайминги.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Задачи моста работают на обоих ядрах: сеть на одном, UART на другом.
CONFIG_FREERTOS_UNICORE=n
